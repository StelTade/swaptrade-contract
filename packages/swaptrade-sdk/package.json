{
  "name": "@swaptrade/sdk",
  "version": "0.1.0",
  "description": "Lightweight TypeScript SDK for the SwapTrade Soroban contracts",
  "license": "Apache-2.0",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@stellar/stellar-sdk": "^14.0.0"
  },
  "devDependencies": {
    "typescript": "^5.6.3",
    "vitest": "^4.1.11"
  }
}
